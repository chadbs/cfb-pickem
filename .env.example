# Local development needs none of this — it falls back to a SQLite file at
# ./data/pickem.db. Copy to .env.local only when pointing at a hosted database.

# Turso / libSQL. Leave unset for the local file.
# DATABASE_URL=libsql://your-db-name-you.turso.io
# DATABASE_AUTH_TOKEN=

# Optional shared secret so only your cron can hit /api/cron/sync.
# CRON_SECRET=
